# CipherChat 3.0 Environment Configuration Template

# Homeserver Settings
VITE_MATRIX_HOMESERVER_URL=http://localhost:8008
VITE_MATRIX_SERVER_NAME=cipherchat.local

# WebRTC & Coturn STUN/TURN Settings
VITE_TURN_SERVER_URL=turn:localhost:3478
VITE_STUN_SERVER_URL=stun:localhost:3478

# PostgreSQL Credentials (for Docker deployment)
POSTGRES_DB=synapse
POSTGRES_USER=synapse_user
POSTGRES_PASSWORD=ReplaceWithStrongPasswordSecureDb!

# Synapse Secrets
SYNAPSE_REGISTRATION_SHARED_SECRET=ReplaceWithStrongRegistrationSharedSecret!
SYNAPSE_MACAROON_SECRET_KEY=ReplaceWithStrongMacaroonSecretKey!
SYNAPSE_FORM_SECRET=ReplaceWithStrongFormSecret!

# Coturn Secret
COTURN_SHARED_SECRET=ReplaceWithStrongCoturnTurnSharedSecret!
